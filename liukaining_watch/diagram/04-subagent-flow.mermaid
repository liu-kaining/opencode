%% 子 Agent 流程图 — task 工具派生子 Session

flowchart TB
  subgraph Parent["父 Session (Primary Agent: build/plan)"]
    P1["用户: 帮我探索整个代码库的认证流程"]
    P2["Primary Agent 决定调用 task 工具"]
    P3["TaskTool.execute()<br/>packages/opencode/src/tool/task.ts"]
  end

  subgraph TaskTool["task 工具逻辑"]
    T1["验证 subagent_type<br/>(general / explore / ...)"]
    T2["Agent.get(subagent_type)<br/>mode 必须为 subagent"]
    T3{"子 Session 已存在?"}
    T4["创建子 Session<br/>parentID = 父 sessionID"]
    T5["deriveSubagentSessionPermission()<br/>继承父权限 + 子 agent 规则"]
    T6{"background?"}
  end

  subgraph Child["子 Session (Subagent)"]
    C1["SessionPrompt.prompt() — V1 路径<br/>或未来 V2 prompt"]
    C2["Subagent 独立运行<br/>general: 多步研究<br/>explore: 只读探索"]
    C3["子 Session 工具集<br/>受 derived permissions 约束"]
    C4["子 Session 完成"]
  end

  subgraph Return["结果回传父 Session"]
    R1["Foreground: 阻塞等待子 Session 完成"]
    R2["Background: 立即返回 taskID<br/>完成后注入 synthetic result"]
    R3["tool-result 返回父 Agent"]
    P4["Primary Agent 继续推理/回复用户"]
  end

  subgraph Agents["内置 Agent 类型 (packages/core/src/plugin/agent.ts)"]
    AG1["build — primary, 默认"]
    AG2["plan — primary, 规划模式"]
    AG3["general — subagent, 多步任务"]
    AG4["explore — subagent, 只读探索"]
    AG5["compaction/title/summary — hidden primary"]
  end

  P1 --> P2 --> P3 --> T1 --> T2 --> T3
  T3 -->|否| T4
  T3 -->|是 resume| T5
  T4 --> T5 --> T6
  T6 -->|false| C1
  T6 -->|true experimental| R2
  C1 --> C2 --> C3 --> C4
  C4 --> R1 --> R3
  R2 -.->|async| C1
  R3 --> P4

  T2 -.-> AG3
  T2 -.-> AG4

  style Parent fill:#e3f2fd
  style Child fill:#f3e5f5
  style Agents fill:#fff8e1

  subgraph KeyPoint["要点"]
    KP["Subagent 不是独立 Runner 类型<br/>而是带 parentID 的普通 Session<br/>通过 task 工具编排"]
  end

  TaskTool -.-> KeyPoint
